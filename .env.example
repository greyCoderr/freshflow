NODE_ENV=development
PORT=3000
# XAMPP MariaDB/MySQL default (no password). Create DB first: CREATE DATABASE freshflow;
DATABASE_URL="mysql://root:@127.0.0.1:3306/freshflow"
# DB tests (npm test / npm run test:db) wipe this database. Its name must end in _test. Created automatically.
TEST_DATABASE_URL="mysql://root:@127.0.0.1:3306/freshflow_test"
JWT_SECRET=dev-only-change-me-dev-only-change-me-0123
COOKIE_SECURE=false
SESSION_HOURS=12
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin2026!
# Temporary password for accounts the admin creates; the user must change it at first sign-in.
DEFAULT_PASSWORD=FreshFlow2026!
# Sign-in/register attempts per IP per 15 minutes
AUTH_RATE_LIMIT=30
CLIENT_ORIGIN=http://localhost:5173
