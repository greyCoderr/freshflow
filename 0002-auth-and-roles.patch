+import { ArrowLeftRight, ClipboardList, FileText, History, IdCard, LayoutDashboard, MessageSquare, Package, ShieldCheck, ShoppingBasket, UserCog, Users, type LucideIcon } from "lucide-react";
+import type { Permission } from "@freshflow/shared";
+
+export interface StaffNavItem { to: string; label: string; icon: LucideIcon; permission: Permission | null; group: string }
+
+/** Rail items and staff routes come from this one list, so a link is shown only where the route allows. */
+export const STAFF_NAV: readonly StaffNavItem[] = [
+  { to: "/staff", label: "Dashboard", icon: LayoutDashboard, permission: null, group: "" },
+  { to: "/staff/pos", label: "Point of Sale", icon: ShoppingBasket, permission: "pos.sell", group: "Selling" },
+  { to: "/staff/orders", label: "Orders", icon: ClipboardList, permission: "order.manage", group: "Selling" },
+  { to: "/staff/concerns", label: "Concerns", icon: MessageSquare, permission: "concern.respond", group: "Selling" },
+  { to: "/staff/inventory", label: "Inventory", icon: Package, permission: "inventory.view", group: "Stock" },
+  { to: "/staff/movements", label: "Stock Movements", icon: ArrowLeftRight, permission: "movement.view", group: "Stock" },
+  { to: "/staff/members", label: "Members", icon: Users, permission: "member.view", group: "People" },
+  { to: "/staff/employees", label: "Employees", icon: IdCard, permission: "employee.view", group: "People" },
+  { to: "/staff/reports", label: "Reports", icon: FileText, permission: "report.view", group: "Office" },
+  { to: "/staff/users", label: "Users", icon: UserCog, permission: "user.manage", group: "Office" },
+  { to: "/staff/roles", label: "Roles & Permissions", icon: ShieldCheck, permission: "role.manage", group: "Office" },
+  { to: "/staff/audit", label: "Audit Log", icon: History, permission: "audit.view", group: "Office" },
+];
+
+export function sectionFor(pathname: string): StaffNavItem | undefined {
+  return [...STAFF_NAV].sort((a, b) => b.to.length - a.to.length).find((n) => pathname === n.to || pathname.startsWith(n.to + "/"));
+}
diff --git a/frontend/src/lib/api.ts b/frontend/src/lib/api.ts
index 2178cc5..7629e4d 100644
--- a/frontend/src/lib/api.ts
+++ b/frontend/src/lib/api.ts
@@ -1,9 +1,31 @@
 export class ApiError extends Error {
   constructor(public status: number, message: string, public code?: string, public fields?: Record<string, string[]>) { super(message); }
 }
+
+/** Fired so the session layer can react without every page handling it. */
+export const SESSION_EXPIRED_EVENT = "ff:session-expired";
+export const PASSWORD_CHANGE_EVENT = "ff:password-change-required";
+
 export async function api<T>(path: string, init?: RequestInit): Promise<T> {
-  const res = await fetch(`/api${path}`, { credentials: "include", headers: { "Content-Type": "application/json" }, ...init });
+  let res: Response;
+  try {
+    res = await fetch(`/api${path}`, { credentials: "include", headers: { "Content-Type": "application/json" }, ...init });
+  } catch {
+    throw new ApiError(0, "Cannot reach FreshFlow. Check your connection, then try again.", "offline");
+  }
   const body = await res.json().catch(() => ({}));
-  if (!res.ok) throw new ApiError(res.status, body.error ?? "Something went wrong. Please try again.", body.code, body.fields);
+  if (!res.ok) {
+    // Login and /me answer 401 as a normal result; everywhere else a 401 means the session ended.
+    if (res.status === 401 && !path.startsWith("/auth/")) window.dispatchEvent(new Event(SESSION_EXPIRED_EVENT));
+    if (res.status === 403 && body.code === "password_change_required") window.dispatchEvent(new Event(PASSWORD_CHANGE_EVENT));
+    throw new ApiError(res.status, body.error ?? "Something went wrong. Please try again.", body.code, body.fields);
+  }
   return body as T;
 }
+
+export const post = <T>(path: string, data?: unknown) => api<T>(path, { method: "POST", body: data === undefined ? undefined : JSON.stringify(data) });
+
+/** Only same-site paths are accepted as a post-login destination (no open redirects). */
+export function safeNext(next: string | null): string | null {
+  return next && next.startsWith("/") && !next.startsWith("//") && !next.startsWith("/login") ? next : null;
+}
diff --git a/frontend/src/lib/session.tsx b/frontend/src/lib/session.tsx
new file mode 100644
index 0000000..41979be
--- /dev/null
+++ b/frontend/src/lib/session.tsx
@@ -0,0 +1,72 @@
+import { createContext, useCallback, useContext, useEffect, useMemo, useState, type ReactNode } from "react";
+import { useQuery, useQueryClient } from "@tanstack/react-query";
+import type { Permission, RoleName } from "@freshflow/shared";
+import { api, ApiError, PASSWORD_CHANGE_EVENT, post, SESSION_EXPIRED_EVENT } from "./api";
+
+export interface SessionUser {
+  id: number; fullName: string; email: string; username: string | null;
+  role: RoleName; permissions: Permission[]; mustChangePassword: boolean;
+}
+interface SessionValue {
+  user: SessionUser | null;
+  loading: boolean;
+  error: ApiError | null;
+  /** True after a request found the session gone (shown as "your session ended" on the login page). */
+  expired: boolean;
+  can: (p: Permission) => boolean;
+  refresh: () => Promise<SessionUser | null>;
+  signOut: () => Promise<void>;
+  retry: () => void;
+}
+const Ctx = createContext<SessionValue | null>(null);
+const ME = ["me"] as const;
+
+async function fetchMe(): Promise<SessionUser | null> {
+  try { return await api<SessionUser>("/auth/me"); }
+  catch (e) { if (e instanceof ApiError && e.status === 401) return null; throw e; }
+}
+
+export function SessionProvider({ children }: { children: ReactNode }) {
+  const qc = useQueryClient();
+  const q = useQuery({ queryKey: ME, queryFn: fetchMe, staleTime: 5 * 60_000, retry: false });
+  const [expired, setExpired] = useState(false);
+
+  useEffect(() => {
+    const onExpired = () => { if (qc.getQueryData(ME)) setExpired(true); qc.setQueryData(ME, null); };
+    const onPw = () => { void qc.invalidateQueries({ queryKey: ME }); };
+    window.addEventListener(SESSION_EXPIRED_EVENT, onExpired);
+    window.addEventListener(PASSWORD_CHANGE_EVENT, onPw);
+    return () => { window.removeEventListener(SESSION_EXPIRED_EVENT, onExpired); window.removeEventListener(PASSWORD_CHANGE_EVENT, onPw); };
+  }, [qc]);
+
+  const refresh = useCallback(async () => {
+    setExpired(false);
+    const u = await fetchMe();
+    qc.setQueryData(ME, u);
+    return u;
+  }, [qc]);
+
+  const signOut = useCallback(async () => {
+    try { await post("/auth/logout"); } finally {
+      qc.clear();
+      qc.setQueryData(ME, null);
+      setExpired(false);
+    }
+  }, [qc]);
+
+  const value = useMemo<SessionValue>(() => {
+    const user = q.data ?? null;
+    return {
+      user, loading: q.isPending, error: q.error instanceof ApiError ? q.error : q.error ? new ApiError(0, "Could not load your account.") : null,
+      expired, can: (p) => !!user?.permissions.includes(p), refresh, signOut, retry: () => void q.refetch(),
+    };
+  }, [q.data, q.isPending, q.error, expired, refresh, signOut, q]);
+
+  return <Ctx.Provider value={value}>{children}</Ctx.Provider>;
+}
+
+export function useSession() {
+  const v = useContext(Ctx);
+  if (!v) throw new Error("useSession outside SessionProvider");
+  return v;
+}
