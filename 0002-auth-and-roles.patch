index 0000000..3b3c5b2
--- /dev/null
+++ b/frontend/src/pages/staff/Dashboard.tsx
@@ -0,0 +1,31 @@
+import { Link } from "react-router-dom";
+import { ROLE_LABELS } from "@freshflow/shared";
+import { useSession } from "../../lib/session";
+import { PageHead } from "../../components/PageHead";
+import { STAFF_NAV } from "../../layouts/staffNav";
+
+function greeting(d = new Date()) {
+  const h = d.getHours();
+  return h < 12 ? "Good morning" : h < 18 ? "Good afternoon" : "Good evening";
+}
+
+/** Figures (sales, orders, stock, concerns) arrive with real data in a later patch; nothing is invented here. */
+export function Dashboard() {
+  const s = useSession();
+  const u = s.user!;
+  const sections = STAFF_NAV.filter((n) => n.permission && s.can(n.permission));
+  return (
+    <>
+      <PageHead title="Dashboard" />
+      <p className="lead">{greeting()}, {u.fullName.split(" ")[0]}. You are signed in as <strong>{ROLE_LABELS[u.role]}</strong>.</p>
+      <section aria-labelledby="sec-h" className="ruled-section">
+        <h2 id="sec-h">Your sections</h2>
+        <ul className="index-list">
+          {sections.map(({ to, label, icon: Icon }) => (
+            <li key={to}><Link to={to}><Icon size={20} strokeWidth={1.5} aria-hidden /> <span>{label}</span></Link></li>
+          ))}
+        </ul>
+      </section>
+    </>
+  );
+}
diff --git a/frontend/src/pages/staff/Users.tsx b/frontend/src/pages/staff/Users.tsx
new file mode 100644
index 0000000..f12d1a7
--- /dev/null
+++ b/frontend/src/pages/staff/Users.tsx
@@ -0,0 +1,116 @@
+import { useState } from "react";
+import { useMutation, useQuery, useQueryClient } from "@tanstack/react-query";
+import { ROLE_LABELS, type RoleName } from "@freshflow/shared";
+import { api, ApiError, post } from "../../lib/api";
+import { useSession } from "../../lib/session";
+import { PageHead } from "../../components/PageHead";
+import { Field } from "../../components/Field";
+import { ConfirmDialog } from "../../components/ConfirmDialog";
+
+interface UserRow { id: number; fullName: string; email: string; username: string | null; role: RoleName; status: "ACTIVE" | "INACTIVE"; mustChangePassword: boolean; createdAt: string }
+const STAFF_ROLES: RoleName[] = ["SALES", "PLANT_STAFF", "MEMBERSHIP_HR", "ADMIN"];
+const fmtDate = (iso: string) => new Date(iso).toLocaleDateString("en-PH", { month: "short", day: "numeric", year: "numeric" });
+
+/** Minimal account list and staff account creation. The full admin area (roles, resets, audit) is patch 0011. */
+export function Users() {
+  const qc = useQueryClient();
+  const me = useSession().user!;
+  const q = useQuery({ queryKey: ["users"], queryFn: () => api<UserRow[]>("/users") });
+  const [adding, setAdding] = useState(false);
+  const [fields, setFields] = useState<Record<string, string[] | undefined>>({});
+  const [formErr, setFormErr] = useState("");
+  const [notice, setNotice] = useState("");
+  const [target, setTarget] = useState<UserRow | null>(null);
+
+  const create = useMutation({
+    mutationFn: (d: Record<string, string>) => post<UserRow>("/users", d),
+    onSuccess: (u) => {
+      setAdding(false); setFields({}); setFormErr("");
+      setNotice(`Account for ${u.fullName} created. They sign in with the temporary password from the server settings and must choose their own right away.`);
+      void qc.invalidateQueries({ queryKey: ["users"] });
+    },
+    onError: (x) => { if (x instanceof ApiError) { setFields(x.fields ?? {}); setFormErr(x.fields ? "" : x.message); } },
+  });
+  const toggle = useMutation({
+    mutationFn: (u: UserRow) => post(`/users/${u.id}/${u.status === "ACTIVE" ? "deactivate" : "activate"}`),
+    onSuccess: (_d, u) => {
+      setTarget(null);
+      setNotice(u.status === "ACTIVE" ? `${u.fullName} is deactivated and signed out everywhere. Their past records stay.` : `${u.fullName} can sign in again.`);
+      void qc.invalidateQueries({ queryKey: ["users"] });
+    },
+    onError: (x) => { setTarget(null); setNotice(x instanceof ApiError ? x.message : "Could not change the account."); },
+  });
+
+  function submit(e: React.FormEvent<HTMLFormElement>) {
+    e.preventDefault();
+    const f = Object.fromEntries(new FormData(e.currentTarget)) as Record<string, string>;
+    const d: Record<string, string> = { fullName: f.fullName ?? "", email: f.email ?? "", role: f.role ?? "" };
+    if (f.username?.trim()) d.username = f.username.trim();
+    create.mutate(d);
+  }
+
+  return (
+    <>
+      <PageHead title="Users" action={!adding && <button className="btn" onClick={() => { setAdding(true); setNotice(""); }}>Add staff account</button>} />
+      {notice && <p className="notice ok" role="status">{notice}</p>}
+
+      {adding && (
+        <section className="ruled-section" aria-labelledby="add-h">
+          <h2 id="add-h">New staff account</h2>
+          <form onSubmit={submit} noValidate className="form-grid">
+            <Field label="Full name" name="fullName" required error={fields.fullName} />
+            <Field label="Email" name="email" type="email" required error={fields.email} />
+            <Field label="Username (optional)" name="username" autoComplete="off" error={fields.username} />
+            <div className="field">
+              <label htmlFor="role">Role</label>
+              <select id="role" name="role" required defaultValue="SALES">
+                {STAFF_ROLES.map((r) => <option key={r} value={r}>{ROLE_LABELS[r]}</option>)}
+              </select>
+            </div>
+            <p className="hint span-2">No password is entered here. The account gets the temporary password and must change it at first sign-in.</p>
+            {formErr && <p role="alert" className="notice danger span-2">{formErr}</p>}
+            <div className="span-2 row-actions">
+              <button className="btn" disabled={create.isPending}>{create.isPending ? "Creating…" : "Create account"}</button>
+              <button type="button" className="btn ghost" onClick={() => setAdding(false)}>Cancel</button>
+            </div>
+          </form>
+        </section>
+      )}
+
+      {q.isPending && <p role="status">Loading accounts…</p>}
+      {q.isError && <div role="alert"><p>{q.error.message}</p><button className="btn ghost" onClick={() => q.refetch()}>Try again</button></div>}
+      {q.data && (
+        <div className="table-scroll">
+          <table className="ledger">
+            <thead><tr><th scope="col">Name</th><th scope="col">Email / username</th><th scope="col">Role</th><th scope="col">Status</th><th scope="col">Since</th><th scope="col"><span className="sr-only">Actions</span></th></tr></thead>
+            <tbody>
+              {q.data.map((u) => (
+                <tr key={u.id}>
+                  <th scope="row">{u.fullName}</th>
+                  <td>{u.email}{u.username && <><br /><span className="mono quiet">{u.username}</span></>}</td>
+                  <td>{ROLE_LABELS[u.role]}</td>
+                  <td>
+                    <span className={`mark ${u.status === "ACTIVE" ? "mark-active" : "mark-ended"}`}><span aria-hidden="true">{u.status === "ACTIVE" ? "●" : "✕"}</span> {u.status === "ACTIVE" ? "Active" : "Inactive"}</span>
+                    {u.mustChangePassword && <span className="mark mark-quiet tag-gap">Temporary password</span>}
+                  </td>
+                  <td className="mono">{fmtDate(u.createdAt)}</td>
+                  <td className="num">
+                    {u.id !== me.id && <button className="btn ghost small" onClick={() => setTarget(u)}>{u.status === "ACTIVE" ? "Deactivate" : "Activate"}</button>}
+                  </td>
+                </tr>
+              ))}
+            </tbody>
+          </table>
+        </div>
+      )}
+
+      <ConfirmDialog open={!!target} title={target?.status === "ACTIVE" ? `Deactivate ${target?.fullName}?` : `Activate ${target?.fullName}?`}
+        confirmLabel={target?.status === "ACTIVE" ? "Deactivate" : "Activate"} danger={target?.status === "ACTIVE"} busy={toggle.isPending}
+        onCancel={() => setTarget(null)} onConfirm={() => target && toggle.mutate(target)}>
+        {target?.status === "ACTIVE"
+          ? <p>They are signed out at once and cannot sign in. Orders, sales and records they made are kept.</p>
+          : <p>They can sign in again with their current password.</p>}
+      </ConfirmDialog>
+    </>
+  );
+}
diff --git a/frontend/src/styles/shell.css b/frontend/src/styles/shell.css
new file mode 100644
index 0000000..d90871e
--- /dev/null
+++ b/frontend/src/styles/shell.css
@@ -0,0 +1,140 @@
+/* Patch 0002: auth pages, customer top bar, staff rail, error pages, dialogs. Tokens only (07 §3). */
+
+.sr-only{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}
+.skip{position:absolute;left:8px;top:-60px;z-index:50;background:var(--pine);color:var(--ivory);padding:10px 14px;border-radius:var(--r-sm)}
+.skip:focus{top:8px}
+.quiet{color:var(--ink-2)}
+.lead{font-size:1.125rem;max-width:68ch}
+.narrow{max-width:640px}
+.page{padding-top:40px;padding-bottom:80px}
+
+/* buttons and fields */
+.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;text-decoration:none;transition:background-color 140ms ease-out}
+.btn.block{width:100%}
+.btn.small{min-height:36px;padding:0 12px;font-size:.875rem}
+.btn.ghost:hover{background:color-mix(in srgb,var(--sage) 50%,transparent)}
+.btn.danger{background:var(--berry);border-color:var(--berry)}
+.btn.danger:hover{background:color-mix(in srgb,var(--berry) 85%,var(--ink))}
+.linklike{background:none;border:0;padding:4px 0;color:var(--pine);text-decoration:underline;font:inherit;cursor:pointer}
+.field .hint,.hint{color:var(--ink-2);font-size:.875rem}
+.field input[aria-invalid]{border-color:var(--berry);box-shadow:inset 3px 0 0 var(--berry)}
+.field select{min-height:44px;padding:0 10px;border:1px solid var(--ink-2);border-radius:var(--r-sm);background:#fff;font:inherit;color:var(--ink)}
+.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:0 20px;align-items:start}
+.field{align-content:start}
+.form-grid .span-2{grid-column:1 / -1}
+.row-actions{display:flex;gap:12px;flex-wrap:wrap}
+@media (max-width:640px){.form-grid{grid-template-columns:1fr}}
+
+/* notices: text + tone, never color alone */
+.notice{margin:0 0 16px;padding:10px 12px;border:1px solid var(--rule);border-left-width:4px;border-radius:var(--r-sm);background:var(--paper);max-width:68ch}
+.notice.danger{border-color:var(--berry);background:var(--berry-bg);color:var(--ink)}
+.notice.attention{border-color:var(--clay);background:var(--clay-bg);color:var(--ink)}
+.notice.ok{border-color:var(--pine);background:var(--sage)}
+
+/* auth pages: the receipt slip on the ivory page */
+.auth-page{min-height:100vh;display:flex;flex-direction:column;align-items:center;padding:48px 16px 64px;gap:24px}
+.auth-mast{display:flex;flex-direction:column;align-items:center;gap:2px}
+.auth-mast .brand{font-size:2rem}
+.auth-coop{font-size:.75rem;letter-spacing:.08em;text-transform:uppercase;color:var(--sage-d)}
+.auth-slip{width:100%;max-width:420px;padding:40px 32px 36px;background:#fffdf6}
+.auth-slip.wide{max-width:600px}
+.auth-slip h1{font-size:1.75rem;margin-bottom:8px}
+.auth-lead{color:var(--ink-2);margin:0 0 24px}
+.auth-slip form{border-top:1px dashed var(--rule);padding-top:20px}
+.auth-foot{margin-top:20px;padding-top:16px;border-top:1px dashed var(--rule);font-size:.9375rem}
+.auth-foot p{margin:0 0 6px}
+@media (max-width:480px){.auth-slip{padding:32px 20px 28px}}
+
+/* customer top bar */
+.top{background:var(--ivory);position:relative;z-index:10}
+.top-end{display:flex;align-items:center;gap:18px;margin-left:auto}
+.top-link{display:inline-flex;align-items:center;gap:6px;color:var(--ink);text-decoration:none;padding:12px 0;border-bottom:3px solid transparent}
+.top-link.active{border-color:var(--pine);font-weight:600}
+.sheet-btn{display:none}
+.sheet{position:fixed;left:0;right:0;bottom:0;z-index:30;background:var(--ivory);border-top:1px solid var(--rule);border-radius:var(--r-md) var(--r-md) 0 0;padding:12px 16px 24px;display:grid}
+.sheet a{padding:14px 4px;border-bottom:1px solid var(--rule);color:var(--ink);text-decoration:none;font-size:1.0625rem}
+.sheet a.active{font-weight:600;color:var(--pine)}
+@media (max-width:760px){
+  .top .wrap{flex-wrap:nowrap;gap:12px}
+  .top-nav{display:none!important}
+  .top-end{gap:12px}
+  .top-end .top-link span{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)}
+  .top-end .top-link{min-width:44px;justify-content:center}
+  .sheet-btn{display:inline-flex;padding:0 12px}
+}
+
+/* scrim (drawers, sheets) */
+.scrim{display:none;position:fixed;inset:0;background:color-mix(in srgb,var(--ink) 45%,transparent);z-index:20}
+.scrim.show{display:block}
+
+/* staff workspace: left rail 232px, pine-d, labels always visible */
+.staff{display:grid;grid-template-columns:232px 1fr;min-height:100vh}
+.rail{background:var(--pine-d);color:var(--ivory);display:flex;flex-direction:column;position:sticky;top:0;height:100vh;overflow-y:auto}
+.rail a,.rail button{color:var(--ivory)}
+.rail :focus-visible{box-shadow:0 0 0 2px var(--pine-d),0 0 0 4px var(--ivory)}
+.rail-head{padding:20px 20px 16px;border-bottom:1px solid color-mix(in srgb,var(--ivory) 18%,transparent);position:relative}
+.rail-brand{font-family:var(--font-display);font-size:1.5rem;text-decoration:none;display:block}
+.rail-sub{font-size:.75rem;letter-spacing:.06em;text-transform:uppercase;opacity:.8}
+.rail-close{display:none;position:absolute;right:10px;top:14px;width:44px;height:44px;background:none;border:0;cursor:pointer;border-radius:var(--r-sm)}
+.rail-links{flex:1;padding:8px 0}
+.rail-group ul{list-style:none;margin:0;padding:0}
+.rail-label{margin:12px 20px 2px;font-size:.75rem;letter-spacing:.08em;text-transform:uppercase;opacity:.75}
+.rail-links a{display:flex;align-items:center;gap:12px;min-height:40px;padding:0 20px 0 17px;border-left:3px solid transparent;text-decoration:none;font-size:.9375rem;transition:background-color 140ms ease-out}
+.rail-links a:hover{background:color-mix(in srgb,var(--pine) 60%,var(--pine-d))}
+.rail-links a.active{background:var(--pine);border-left-color:var(--ivory);font-weight:600}
+.rail-foot{padding:16px 20px 20px;border-top:1px solid color-mix(in srgb,var(--ivory) 18%,transparent)}
+.rail-name{margin:0;font-weight:600}
+.rail-role{margin:0 0 10px;font-size:.875rem;opacity:.85}
+.rail-action{display:flex;align-items:center;gap:10px;min-height:40px;width:100%;padding:0;background:none;border:0;font:inherit;font-size:.9375rem;text-decoration:none;cursor:pointer}
+.rail-action:hover span{text-decoration:underline}
+.staff-main{min-width:0;display:flex;flex-direction:column}
+.staff-bar{display:none}
+.staff-content{padding:32px 40px 80px;max-width:1360px;width:100%}
+.staff-content:focus{outline:none}
+.page-head{display:flex;align-items:flex-end;justify-content:space-between;gap:16px;flex-wrap:wrap;padding-bottom:16px;margin-bottom:24px;border-bottom:1px solid var(--rule)}
+.page-head h1{margin:0;font-size:2.25rem}
+@media (max-width:1023px){
+  .staff{grid-template-columns:1fr}
+  .rail{position:fixed;left:0;top:0;bottom:0;width:min(300px,86vw);z-index:30;transform:translateX(-100%);visibility:hidden;transition:transform 220ms ease-out,visibility 0s 220ms}
+  .drawer-open .rail{transform:none;visibility:visible;transition:transform 220ms ease-out}
+  .drawer-open .scrim{display:block}
+  .rail-close{display:grid;place-items:center}
+  .staff-bar{display:flex;align-items:center;gap:16px;min-height:60px;padding:0 16px;border-bottom:1px solid var(--rule);background:var(--paper);position:sticky;top:0;z-index:10}
+  .menu-btn{padding:0 14px}
+  .staff-section{font-family:var(--font-display);font-size:1.25rem}
+  .staff-content{padding:24px 16px 64px}
+  .page-head h1{font-size:1.75rem}
+}
+@media (prefers-reduced-motion:reduce){.rail{transition:none!important}}
+
+/* ruled sections, facts, index list */
+.ruled-section{border-top:1px solid var(--rule);padding-top:20px;margin-top:28px}
+.ruled-section h2{font-size:1.375rem}
+.facts{margin:0 0 8px;display:grid}
+.facts div{display:grid;grid-template-columns:160px 1fr;gap:12px;padding:10px 0;border-bottom:1px solid var(--rule)}
+.facts dt{color:var(--ink-2)}
+.facts dd{margin:0}
+@media (max-width:480px){.facts div{grid-template-columns:1fr;gap:2px}}
+.index-list{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));column-gap:32px}
+.index-list a{display:flex;align-items:center;gap:12px;min-height:48px;border-bottom:1px solid var(--rule);color:var(--ink);text-decoration:none}
+.index-list a:hover span{text-decoration:underline;color:var(--pine)}
+.index-list svg{color:var(--sage-d)}
+
+/* ledger extras */
+.table-scroll{overflow-x:auto}
+.ledger th[scope=row]{font-weight:600;text-align:left;background:none;text-transform:none;letter-spacing:0;font-size:1rem;position:static;padding:12px;border-bottom:1px solid var(--rule)}
+.tag-gap{margin-left:6px}
+
+/* 403 / 404 */
+.errpage{max-width:560px;margin:56px auto;padding:0 16px}
+.errcode{display:inline-block;margin:0 0 12px;padding:4px 12px;border:1px solid var(--rule);border-radius:var(--r-sm);background:var(--paper);font-size:1.75rem;letter-spacing:.08em;color:var(--ink-2)}
+.errpage h1{font-size:2rem}
+.errpage p{margin:0 0 24px}
+
+.session-wait{max-width:560px;margin:80px auto;padding:0 16px;text-align:center}
+
+/* dialog: one dim scrim, no shadow */
+.dialog{border:1px solid var(--rule);border-radius:var(--r-md);background:var(--ivory);color:var(--ink);padding:24px;max-width:460px;width:calc(100% - 32px)}
+.dialog::backdrop{background:color-mix(in srgb,var(--ink) 45%,transparent)}
+.dialog h2{font-size:1.375rem}
+.dialog-actions{display:flex;justify-content:flex-end;gap:12px;margin-top:20px;flex-wrap:wrap}
